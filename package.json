{
  "name": "patitas-a-casa",
  "version": "1.0.0",
  "description": "Red solidaria vecinal para el reencuentro de mascotas perdidas en Rosario",
  "private": true,
  "scripts": {
    "dev": "concurrently \"npm:watch:css\" \"npm:serve\"",
    "watch:css": "tailwindcss -i ./css/tailwind.css -o ./css/styles.css --watch",
    "build:css": "tailwindcss -i ./css/tailwind.css -o ./css/styles.css --minify",
    "serve": "serve -l 5173 .",
    "build": "npm run build:css"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17"
  }
}